
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>iPod × Spotify</title>
<script src="https://sdk.scdn.co/spotify-player.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap');
  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: #111;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    background-image: radial-gradient(ellipse at 30% 20%, #1a2a3a 0%, #111 60%);
    flex-direction: column;
    gap: 16px;
  }

  #login-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    color: #fff;
  }
  .login-btn {
    background: #1db954;
    color: #000;
    border: none;
    border-radius: 50px;
    padding: 12px 32px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.1s, background 0.2s;
  }
  .login-btn:hover { background: #1ed760; transform: scale(1.03); }

  #ipod-screen { display: none; }

  .ipod {
    width: 260px;
    background: linear-gradient(160deg, #2e2e2e 0%, #1c1c1c 40%, #252525 100%);
    border-radius: 30px;
    padding: 16px;
    box-shadow: 0 0 0 1px #3a3a3a, 0 30px 80px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.08);
    user-select: none;
  }

  .screen-bezel {
    background: #0a0a0a;
    border-radius: 14px;
    padding: 6px;
    margin-bottom: 20px;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.9);
  }

  .screen {
    width: 100%;
    height: 180px;
    background: #000;
    border-radius: 10px;
    overflow: hidden;
  }

  .status-bar {
    background: linear-gradient(180deg, #1a3a5c 0%, #0f2a44 100%);
    padding: 4px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 9px;
    color: #fff;
    font-weight: 500;
  }
  .status-bar .time { font-size: 10px; font-weight: 600; }
  .battery-icon { width:16px;height:8px;border:1px solid rgba(255,255,255,0.6);border-radius:2px;position:relative;display:inline-block;vertical-align:middle;margin-left:3px; }
  .battery-icon::after { content:'';position:absolute;right:-4px;top:50%;transform:translateY(-50%);width:2px;height:4px;background:rgba(255,255,255,0.6);border-radius:0 1px 1px 0; }
  .battery-fill { position:absolute;left:1px;top:1px;bottom:1px;width:75%;background:#4cd964;border-radius:1px; }

  .view { display:none; height:calc(180px - 21px); }
  .view.active { display:flex; flex-direction:column; }

  #view-loading { background:#000;align-items:center;justify-content:center;gap:8px;color:rgba(255,255,255,0.6);font-size:11px; }
  .spinner { width:20px;height:20px;border:2px solid rgba(255,255,255,0.1);border-top-color:#1db954;border-radius:50%;animation:spin 0.8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }

  #view-now-playing { background:linear-gradient(160deg,#0d1b2e 0%,#050d18 100%);padding:8px 10px;gap:6px; }

  .album-row { display:flex;gap:8px;align-items:center; }
  .album-art { width:56px;height:56px;border-radius:4px;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,0.6);background:linear-gradient(135deg,#1a3a5c,#0a1a2e);display:flex;align-items:center;justify-content:center;font-size:22px; }
  .album-art img { width:100%;height:100%;border-radius:4px;object-fit:cover; }

  .track-info { flex:1;min-width:0; }
  .track-title { color:#fff;font-size:11px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
  .track-artist { color:#8ab4d4;font-size:9px;margin-top:1px; }
  .track-album  { color:#5a8aa8;font-size:8px;margin-top:1px; }
  .spotify-badge { display:flex;align-items:center;gap:3px;color:#1db954;font-size:8px;font-weight:600;margin-top:3px; }

  .progress-section { padding:0 2px; }
  .progress-bar { height:2px;background:rgba(255,255,255,0.15);border-radius:1px; }
  .progress-fill { height:100%;background:linear-gradient(90deg,#1db954,#4cd964);border-radius:1px;width:0%;transition:width 1s linear; }
  .progress-times { display:flex;justify-content:space-between;color:rgba(255,255,255,0.5);font-size:8px;margin-top:2px; }

  .output-bar { display:flex;justify-content:space-between;align-items:center;padding:0 2px; }
  .spotify-info { display:flex;align-items:center;gap:4px;color:rgba(255,255,255,0.6);font-size:8px; }

  #view-menu { background:#c0c8d0; }
  .menu-header { background:linear-gradient(180deg,#6a8aaa 0%,#4a6a8a 100%);padding:4px 8px;color:#fff;font-size:11px;font-weight:600;text-align:center;text-shadow:0 1px 2px rgba(0,0,0,0.4);flex-shrink:0; }
  .menu-list { flex:1;overflow:hidden; }
  .menu-item { display:flex;justify-content:space-between;align-items:center;padding:5px 10px;font-size:11px;color:#1a1a1a;border-bottom:1px solid rgba(0,0,0,0.1);cursor:pointer; }
  .menu-item.selected { background:linear-gradient(90deg,#3a6aaa,#2a5a9a);color:#fff; }
  .menu-item .arrow { font-size:10px;opacity:0.5; }
  .menu-item.selected .arrow { opacity:0.8;color:#fff; }

  #view-tracks { background:#c0c8d0; }

  .wheel-container { display:flex;justify-content:center;align-items:center;position:relative; }
  .wheel { width:160px;height:160px;border-radius:50%;background:radial-gradient(ellipse at 35% 30%,#3a3a3a 0%,#1e1e1e 50%,#151515 100%);position:relative;cursor:pointer;box-shadow:0 0 0 1px rgba(255,255,255,0.06),inset 0 1px 3px rgba(255,255,255,0.08),0 4px 20px rgba(0,0,0,0.6); }
  .center-btn { position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:52px;height:52px;border-radius:50%;background:radial-gradient(ellipse at 40% 35%,#3a3a3a 0%,#1a1a1a 100%);box-shadow:0 0 0 1px rgba(255,255,255,0.08),inset 0 1px 2px rgba(255,255,255,0.1),0 2px 8px rgba(0,0,0,0.5);cursor:pointer;transition:transform 0.1s;z-index:10; }
  .center-btn:active { transform:translate(-50%,-50%) scale(0.95); }

  .wheel-label { position:absolute;color:rgba(255,255,255,0.55);font-size:8px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;pointer-events:none; }
  .wheel-label.top    { top:12px;left:50%;transform:translateX(-50%); }
  .wheel-label.bottom { bottom:12px;left:50%;transform:translateX(-50%); }
  .wheel-label.left   { left:10px;top:50%;transform:translateY(-50%); }
  .wheel-label.right  { right:10px;top:50%;transform:translateY(-50%); }

  .wheel-zone { position:absolute;cursor:pointer; }
  .wheel-zone:active { opacity:0.5; }
  .zone-top    { top:0;left:20%;width:60%;height:35%; }
  .zone-bottom { bottom:0;left:20%;width:60%;height:35%; }
  .zone-left   { left:0;top:20%;width:35%;height:60%; }
  .zone-right  { right:0;top:20%;width:35%;height:60%; }

  @keyframes pulse-glow {
    0%,100% { box-shadow:0 0 0 1px rgba(255,255,255,0.06),0 4px 20px rgba(0,0,0,0.6); }
    50%      { box-shadow:0 0 0 1px rgba(29,185,84,0.3),0 4px 20px rgba(0,0,0,0.6),0 0 20px rgba(29,185,84,0.1); }
  }
  .playing .wheel { animation:pulse-glow 2s ease-in-out infinite; }

  .vol-indicator { position:absolute;bottom:-24px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;color:rgba(255,255,255,0.3);font-size:9px;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity 0.3s; }
  .vol-indicator.show { opacity:1; }
  .vol-bar { display:flex;gap:2px; }
  .vol-bar span { width:3px;height:8px;background:rgba(255,255,255,0.2);border-radius:1px; }
  .vol-bar span.active { background:#1db954; }
</style>
</head>
<body>

<div id="login-screen">
  <div style="font-size:48px">🎵</div>
  <h2 style="font-size:18px;font-weight:600">iPod × Spotify</h2>
  <p style="font-size:12px;color:rgba(255,255,255,0.5);text-align:center;max-width:260px;line-height:1.5">Connecte-toi avec ton compte Spotify pour écouter ta musique</p>
  <button class="login-btn" onclick="login()">Se connecter avec Spotify</button>
</div>

<div id="ipod-screen">
  <div class="ipod" id="ipod">
    <div class="screen-bezel">
      <div class="screen">
        <div class="status-bar">
          <span class="time" id="clock">9:41</span>
          <span style="color:#1db954;font-weight:700;">♫ Spotify</span>
          <div style="display:flex;align-items:center;"><div class="battery-icon"><div class="battery-fill"></div></div></div>
        </div>

        <div class="view active" id="view-loading">
          <div class="spinner"></div><span>Connexion…</span>
        </div>

        <div class="view" id="view-now-playing">
          <div class="album-row">
            <div class="album-art" id="album-art">🎵</div>
            <div class="track-info">
              <div class="track-title" id="track-title">—</div>
              <div class="track-artist" id="track-artist">—</div>
              <div class="track-album"  id="track-album">—</div>
              <div class="spotify-badge">● Spotify</div>
            </div>
          </div>
          <div class="progress-section">
            <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
            <div class="progress-times"><span id="time-current">0:00</span><span id="time-remain">0:00</span></div>
          </div>
          <div class="output-bar">
            <div class="spotify-info">🎧 <span id="device-name">iPod Classic</span></div>
            <div style="display:flex;gap:6px;color:rgba(255,255,255,0.4);font-size:10px;">
              <span id="shuffle-icon" style="cursor:pointer" onclick="toggleShuffle()">⇄</span>
              <span id="repeat-icon"  style="cursor:pointer" onclick="toggleRepeat()">↺</span>
            </div>
          </div>
        </div>

        <div class="view" id="view-menu">
          <div class="menu-header">iPod × Spotify</div>
          <div class="menu-list" id="menu-list">
            <div class="menu-item selected"><span>En cours</span><span class="arrow">›</span></div>
            <div class="menu-item"><span>Top Tracks</span><span class="arrow">›</span></div>
            <div class="menu-item"><span>Récemment joué</span><span class="arrow">›</span></div>
            <div class="menu-item"><span>Mes Playlists</span><span class="arrow">›</span></div>
          </div>
        </div>

        <div class="view" id="view-tracks">
          <div class="menu-header" id="tracks-header">Musique</div>
          <div class="menu-list" id="tracks-list"></div>
        </div>
      </div>
    </div>

    <div class="wheel-container">
      <div class="wheel" id="wheel">
        <span class="wheel-label top">MENU</span>
        <span class="wheel-label bottom">▶II</span>
        <span class="wheel-label left">◀◀</span>
        <span class="wheel-label right">▶▶</span>
        <div class="wheel-zone zone-top"    onclick="wheelAction('menu')"></div>
        <div class="wheel-zone zone-bottom" onclick="wheelAction('playpause')"></div>
        <div class="wheel-zone zone-left"   onclick="wheelAction('prev')"></div>
        <div class="wheel-zone zone-right"  onclick="wheelAction('next')"></div>
        <div class="center-btn" onclick="wheelAction('select')"></div>
        <div class="vol-indicator" id="vol-indicator">
          <span>🔈</span><div class="vol-bar" id="vol-bar"></div><span>🔊</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const CLIENT_ID    = '18aefc08cc824f05a71c3ecf2011f28f';
const REDIRECT_URI = window.location.href.split('?')[0].split('#')[0];
const SCOPES = 'streaming user-read-email user-read-private user-read-playback-state user-modify-playback-state user-read-currently-playing user-top-read user-read-recently-played playlist-read-private';

// ── PKCE ──────────────────────────────────────────────────────────────────
function rnd(n){const c='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';return Array.from(crypto.getRandomValues(new Uint8Array(n))).map(b=>c[b%c.length]).join('');}
async function sha256(s){return crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));}
function b64url(buf){return btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}

async function login() {
  const verifier=rnd(64), challenge=b64url(await sha256(verifier));
  localStorage.setItem('pkce_v',verifier);
  const p=new URLSearchParams({client_id:CLIENT_ID,response_type:'code',redirect_uri:REDIRECT_URI,code_challenge_method:'S256',code_challenge:challenge,scope:SCOPES});
  window.location='https://accounts.spotify.com/authorize?'+p;
}

async function exchangeCode(code) {
  const res=await fetch('https://accounts.spotify.com/api/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({client_id:CLIENT_ID,grant_type:'authorization_code',code,redirect_uri:REDIRECT_URI,code_verifier:localStorage.getItem('pkce_v')})});
  const d=await res.json();
  if(d.access_token){save(d);return d.access_token;}
  return null;
}

async function doRefresh() {
  const r=localStorage.getItem('sp_refresh');if(!r)return null;
  const res=await fetch('https://accounts.spotify.com/api/token',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({client_id:CLIENT_ID,grant_type:'refresh_token',refresh_token:r})});
  const d=await res.json();
  if(d.access_token){save(d);return d.access_token;}
  return null;
}

function save(d){localStorage.setItem('sp_token',d.access_token);localStorage.setItem('sp_exp',Date.now()+d.expires_in*1000);if(d.refresh_token)localStorage.setItem('sp_refresh',d.refresh_token);}

async function tok(){
  const exp=parseInt(localStorage.getItem('sp_exp')||'0');
  if(Date.now()<exp-60000)return localStorage.getItem('sp_token');
  return doRefresh();
}

// ── API ───────────────────────────────────────────────────────────────────
async function api(ep,method='GET',body=null){
  const t=await tok();if(!t){login();return null;}
  const o={method,headers:{Authorization:`Bearer ${t}`,'Content-Type':'application/json'}};
  if(body)o.body=JSON.stringify(body);
  const res=await fetch(`https://api.spotify.com/${ep}`,o);
  if(res.status===204||res.status===202)return null;
  return res.json().catch(()=>null);
}

// ── STATE ─────────────────────────────────────────────────────────────────
let S={view:'loading',isPlaying:false,track:null,progress:0,duration:0,volume:8,menuIdx:0,listIdx:0,list:[],shuffle:false,repeat:'off'};
let tick=null,vt=null;
const MENU=['now-playing','tracks','recent','playlists'];

// ── CLOCK ─────────────────────────────────────────────────────────────────
function clock(){const n=new Date();document.getElementById('clock').textContent=n.getHours()+':'+String(n.getMinutes()).padStart(2,'0');}
clock();setInterval(clock,10000);

// ── RENDER ────────────────────────────────────────────────────────────────
function render(){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+S.view).classList.add('active');
  document.getElementById('ipod').classList.toggle('playing',S.isPlaying);

  if(S.track){
    document.getElementById('track-title').textContent=S.track.name||'—';
    document.getElementById('track-artist').textContent=S.track.artists?.map(a=>a.name).join(', ')||'—';
    document.getElementById('track-album').textContent=S.track.album?.name||'—';
    const img=S.track.album?.images?.[0]?.url;
    document.getElementById('album-art').innerHTML=img?`<img src="${img}" alt="">`:'🎵';
    const pct=S.duration?(S.progress/S.duration)*100:0;
    document.getElementById('progress-fill').style.width=pct+'%';
    document.getElementById('time-current').textContent=fmt(S.progress);
    document.getElementById('time-remain').textContent='-'+fmt(Math.max(0,S.duration-S.progress));
  }

  document.querySelectorAll('#menu-list .menu-item').forEach((el,i)=>el.classList.toggle('selected',i===S.menuIdx));

  const tl=document.getElementById('tracks-list');tl.innerHTML='';
  S.list.forEach((item,i)=>{
    const el=document.createElement('div');
    el.className='menu-item'+(i===S.listIdx?' selected':'');
    const name=item.name||'—';
    const sub=(item.artists?.map(a=>a.name).join(', ')||item.description||'').substring(0,14);
    el.innerHTML=`<span style="max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${name}</span><span style="font-size:8px;color:#888;flex-shrink:0">${sub}</span>`;
    tl.appendChild(el);
  });

  const vb=document.getElementById('vol-bar');vb.innerHTML='';
  for(let i=0;i<15;i++){const s=document.createElement('span');if(i<S.volume)s.classList.add('active');vb.appendChild(s);}
  document.getElementById('shuffle-icon').style.color=S.shuffle?'#1db954':'rgba(255,255,255,0.4)';
  document.getElementById('repeat-icon').style.color=S.repeat!=='off'?'#1db954':'rgba(255,255,255,0.4)';
}

function fmt(ms){const s=Math.floor(ms/1000);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');}

// ── SYNC ──────────────────────────────────────────────────────────────────
async function sync(){
  const d=await api('v1/me/player');if(!d)return;
  S.isPlaying=d.is_playing;S.progress=d.progress_ms||0;S.duration=d.item?.duration_ms||0;
  S.track=d.item;S.shuffle=d.shuffle_state;S.repeat=d.repeat_state;
  if(S.view==='loading')S.view='now-playing';
  render();
}

function startTick(){clearInterval(tick);tick=setInterval(()=>{if(S.isPlaying&&S.progress<S.duration){S.progress+=1000;render();}},1000);}

// ── CONTROLS ──────────────────────────────────────────────────────────────
async function togglePlay(){if(S.isPlaying){await api('v1/me/player/pause','PUT');S.isPlaying=false;}else{await api('v1/me/player/play','PUT');S.isPlaying=true;}render();}
async function next(){await api('v1/me/player/next','POST');setTimeout(sync,600);}
async function prev(){await api('v1/me/player/previous','POST');setTimeout(sync,600);}
async function toggleShuffle(){S.shuffle=!S.shuffle;await api(`v1/me/player/shuffle?state=${S.shuffle}`,'PUT');render();}
async function toggleRepeat(){const m=['off','track','context'];S.repeat=m[(m.indexOf(S.repeat)+1)%3];await api(`v1/me/player/repeat?state=${S.repeat}`,'PUT');render();}
async function vol(v){S.volume=v;await api(`v1/me/player/volume?volume_percent=${Math.round((v/15)*100)}`,'PUT');}

// ── LISTS ─────────────────────────────────────────────────────────────────
async function loadList(type){
  S.view='tracks';S.listIdx=0;S.list=[];render();
  let h='Musique',d;
  if(type==='tracks'){d=await api('v1/me/top/tracks?time_range=long_term&limit=20');S.list=d?.items||[];h='Top Tracks';}
  else if(type==='recent'){d=await api('v1/me/player/recently-played?limit=20');S.list=(d?.items||[]).map(i=>i.track);h='Récemment joué';}
  else if(type==='playlists'){d=await api('v1/me/playlists?limit=20');S.list=d?.items||[];h='Mes Playlists';}
  document.getElementById('tracks-header').textContent=h;render();
}

async function playItem(item){
  if(!item)return;
  await api('v1/me/player/play','PUT',item.type==='playlist'?{context_uri:item.uri}:{uris:[item.uri]});
  S.isPlaying=true;S.view='now-playing';setTimeout(sync,800);
}

// ── WHEEL ─────────────────────────────────────────────────────────────────
async function wheelAction(a){
  if(a==='menu'){S.view=S.view==='now-playing'?'menu':S.view==='tracks'?'menu':'now-playing';render();return;}
  if(a==='playpause'){S.view==='now-playing'?await togglePlay():scroll(1);return;}
  if(a==='prev'){S.view==='now-playing'?await prev():scroll(-1);return;}
  if(a==='next'){S.view==='now-playing'?await next():scroll(1);return;}
  if(a==='select'){
    if(S.view==='menu'){const c=MENU[S.menuIdx];c==='now-playing'?(S.view='now-playing',render()):await loadList(c);}
    else if(S.view==='tracks')await playItem(S.list[S.listIdx]);
    else await togglePlay();
  }
}

function scroll(d){
  if(S.view==='menu')S.menuIdx=(S.menuIdx+d+MENU.length)%MENU.length;
  else if(S.view==='tracks')S.listIdx=(S.listIdx+d+Math.max(1,S.list.length))%Math.max(1,S.list.length);
  render();
}

// ── SCROLL WHEEL ──────────────────────────────────────────────────────────
let wa=null,la=0;
function ang(e,el){const r=el.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,dx=(e.clientX||e.touches[0].clientX)-cx,dy=(e.clientY||e.touches[0].clientY)-cy;return Math.atan2(dy,dx)*180/Math.PI;}
function inC(e,el){const r=el.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,dx=(e.clientX||e.touches[0].clientX)-cx,dy=(e.clientY||e.touches[0].clientY)-cy;return Math.sqrt(dx*dx+dy*dy)<28;}
const we=document.getElementById('wheel');
we.addEventListener('mousedown',e=>{if(!inC(e,we))wa=ang(e,we);});
window.addEventListener('mousemove',e=>{
  if(wa===null)return;const a=ang(e,we);let d=a-wa;if(d>180)d-=360;if(d<-180)d+=360;
  const now=Date.now();if(Math.abs(d)>18&&now-la>200){la=now;if(S.view==='now-playing'){const nv=d>0?Math.min(15,S.volume+1):Math.max(0,S.volume-1);vol(nv);showV();}else scroll(d>0?1:-1);wa=a;render();}
});
window.addEventListener('mouseup',()=>{wa=null;});
we.addEventListener('touchstart',e=>{if(!inC(e,we))wa=ang(e,we);},{passive:true});
we.addEventListener('touchmove',e=>{
  if(wa===null)return;const a=ang(e,we);let d=a-wa;if(d>180)d-=360;if(d<-180)d+=360;
  const now=Date.now();if(Math.abs(d)>15&&now-la>200){la=now;if(S.view==='now-playing'){const nv=d>0?Math.min(15,S.volume+1):Math.max(0,S.volume-1);vol(nv);showV();}else scroll(d>0?1:-1);wa=a;render();}
},{passive:true});
we.addEventListener('touchend',()=>{wa=null;});
function showV(){const vi=document.getElementById('vol-indicator');vi.classList.add('show');clearTimeout(vt);vt=setTimeout(()=>vi.classList.remove('show'),1500);}

document.addEventListener('keydown',e=>{
  if(e.key===' '||e.key==='Enter')wheelAction('select');
  else if(e.key==='ArrowRight')wheelAction('next');
  else if(e.key==='ArrowLeft')wheelAction('prev');
  else if(e.key==='ArrowUp')scroll(-1);
  else if(e.key==='ArrowDown')scroll(1);
  else if(e.key==='Escape'||e.key==='m')wheelAction('menu');
});

// ── SDK ───────────────────────────────────────────────────────────────────
window.onSpotifyWebPlaybackSDKReady=async()=>{
  const t=await tok();if(!t)return;
  const player=new Spotify.Player({name:'iPod Classic',getOAuthToken:async cb=>{cb(await tok());},volume:0.5});
  player.addListener('ready',async({device_id})=>{
    document.getElementById('device-name').textContent='iPod Classic';
    await api('v1/me/player','PUT',{device_ids:[device_id],play:false});
    setTimeout(sync,1000);startTick();setInterval(sync,15000);
  });
  player.addListener('player_state_changed',s=>{
    if(!s)return;
    S.isPlaying=!s.paused;S.progress=s.position;S.duration=s.duration;
    S.track=s.track_window?.current_track;S.shuffle=s.shuffle;
    if(S.view==='loading')S.view='now-playing';render();
  });
  player.addListener('authentication_error',()=>login());
  player.connect();
};

// ── INIT ──────────────────────────────────────────────────────────────────
async function init(){
  const params=new URLSearchParams(window.location.search);
  const code=params.get('code');
  if(code){
    window.history.replaceState({},'',window.location.pathname);
    const t=await exchangeCode(code);
    if(t){document.getElementById('login-screen').style.display='none';document.getElementById('ipod-screen').style.display='block';}
    else alert('Erreur de connexion, réessaie.');
    return;
  }
  const t=await tok();
  if(t){document.getElementById('login-screen').style.display='none';document.getElementById('ipod-screen').style.display='block';}
  else{document.getElementById('login-screen').style.display='flex';}
}
init();
</script>
