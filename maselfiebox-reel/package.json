{
  "name": "maselfiebox-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Reel vertical Ma Selfie Box — le service complet, 1080x1920, 60 fps (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 audio-src/generate_audio.py",
    "render": "remotion render src/index.ts MaSelfieBoxReel out/maselfiebox-reel-raw.mp4 --codec=h264 --audio-codec=aac --audio-bitrate=320k --crf=16 --x264-preset=slow --pixel-format=yuv420p --concurrency=4 --gl=swangle"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@react-three/fiber": "^9.4.0",
    "@remotion/bundler": "^4.0.542",
    "@remotion/cli": "^4.0.542",
    "@remotion/renderer": "^4.0.542",
    "@remotion/three": "^4.0.542",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.542",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2"
  }
}
