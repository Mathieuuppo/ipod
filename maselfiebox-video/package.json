{
  "name": "maselfiebox-video",
  "version": "1.0.0",
  "private": true,
  "description": "Publicité motion design Ma Selfie Box — 50 s, 1920x1080, 60 fps (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 audio-src/generate_audio.py",
    "render": "remotion render src/index.ts MaSelfieBoxAd out/maselfiebox-pub-50s-raw.mp4 --codec=h264 --audio-codec=aac --crf=16 --x264-preset=slow --pixel-format=yuv420p --concurrency=4",
    "still": "remotion still src/index.ts MaSelfieBoxAd"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@react-three/fiber": "^9.4.0",
    "@remotion/cli": "^4.0.542",
    "@remotion/media": "^4.0.542",
    "@remotion/three": "^4.0.542",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.542",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2"
  }
}
